generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum Role {
  ADMIN
  OPD
}

enum TicketStatus {
  TO_DO
  IN_PROGRESS
  ON_HOLD
  DONE
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketType {
  COMPLAINT
  FEEDBACK
  QUESTION
}

enum ChannelPlatform {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum SenderType {
  WARGA
  ADMIN
  OPD
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum InteractionType {
  COMMENT
  MENTION
}

enum ApprovalSubject {
  MESSAGE
  QUESTION_MESSAGE
}

enum ApprovalVerdict {
  APPROVED
  REJECTED
}

enum AiSubjectType {
  TICKET
  SOCIAL_INTERACTION
}

enum VerificationVerdict {
  VALID
  INVALID
  NEEDS_REROUTE
}

// ============================================
// MODELS
// ============================================

model Opd {
  id   String @id @default(uuid())
  name String @unique

  users               User[]
  tickets             Ticket[]
  categories          Category[]
  ticketVerifications TicketVerification[]
  aiClassifications   AiClassification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  name     String
  phone    String?
  role     Role   @default(OPD)

  opdId String?
  opd   Opd? @relation(fields: [opdId], references: [id], onDelete: SetNull)

  messages            Message[]
  approvals           Approval[]
  ticketVerifications TicketVerification[]
  activityLogs        ActivityLog[]
  attachments         Attachment[]

  aiVerifications AiClassification[] @relation("AiVerifiedBy")
  progressChanges TicketProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Citizen {
  id          String  @id @default(uuid())
  displayName String
  nik         String?
  region      String?
  isBlocked   Boolean @default(false)

  contacts CitizenContact[]
  tickets  Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CitizenContact {
  id       String          @id @default(uuid())
  platform ChannelPlatform
  handle   String

  citizenId String
  citizen   Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([citizenId, platform])
}

model Channel {
  id            String          @id @default(uuid())
  platform      ChannelPlatform @unique
  accountHandle String?
  isActive      Boolean         @default(false)

  tickets            Ticket[]
  socialInteractions SocialInteraction[]

  updatedAt DateTime @updatedAt
}

model Category {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  defaultOpdId String?
  defaultOpd   Opd? @relation(fields: [defaultOpdId], references: [id], onDelete: SetNull)

  tickets             Ticket[]
  ticketVerifications TicketVerification[] @relation("OverrideCategory")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id           String       @id @default(uuid())
  ticketNumber String       @unique
  title        String?
  description  String       @db.Text
  status       TicketStatus @default(TO_DO)
  priority     TicketPriority?
  urgency      TicketUrgency?
  type         TicketType?

  citizenId String
  citizen   Citizen @relation(fields: [citizenId], references: [id], onDelete: Restrict)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Restrict)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  assignedOpdId String?
  assignedOpd   Opd? @relation(fields: [assignedOpdId], references: [id], onDelete: SetNull)

  startDate  DateTime?
  dueDate    DateTime?
  resolvedAt DateTime?
  closedAt   DateTime?

  messages          Message[]
  attachments       Attachment[]
  progress          TicketProgress[]
  verifications     TicketVerification[]
  aiClassifications AiClassification[]

  sourceInteraction SocialInteraction? @relation("TicketSource")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([citizenId])
  @@index([assignedOpdId])
  @@index([channelId])
  @@index([categoryId])
  @@index([createdAt])
}

model TicketProgress {
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  seqNo      Int
  fromStatus TicketStatus?
  toStatus   TicketStatus
  note       String? @db.Text

  changedById String?
  changedBy   User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  changedAt DateTime @default(now())

  @@id([ticketId, seqNo])
}

model TicketVerification {
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  seqNo   Int
  verdict VerificationVerdict

  verifierUserId String?
  verifierUser   User? @relation(fields: [verifierUserId], references: [id], onDelete: SetNull)

  overrideCategoryId String?
  overrideCategory Category? @relation("OverrideCategory", fields: [overrideCategoryId], references: [id], onDelete: SetNull)

  overrideOpdId String?
  overrideOpd   Opd? @relation(fields: [overrideOpdId], references: [id], onDelete: SetNull)

  note       String? @db.Text
  verifiedAt DateTime @default(now())

  @@id([ticketId, seqNo])
}

model Approval {
  id          String @id @default(uuid())
  subjectType ApprovalSubject
  verdict     ApprovalVerdict

  decidedById String?
  decidedBy   User? @relation(fields: [decidedById], references: [id], onDelete: SetNull)

  decidedAt DateTime @default(now())
  reason    String? @db.Text

  messages Message[]

  createdAt DateTime @default(now())
}

model Message {
  id         String @id @default(uuid())
  content    String @db.Text
  senderType SenderType
  direction  MessageDirection
  isInternal Boolean @default(false)
  isApproved Boolean @default(true)
  sentAt     DateTime?

  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  senderUserId String?
  senderUser   User? @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  approvalId String?
  approval   Approval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId])
  @@index([createdAt])
}

model Attachment {
  id        String @id @default(uuid())
  url       String @db.Text
  fileName  String
  mimeType  String
  sizeBytes Int

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  uploadedAt DateTime @default(now())
}

model SocialInteraction {
  id              String @id @default(uuid())
  interactionType InteractionType
  externalId      String
  username        String
  content         String @db.Text
  permalink       String?
  isTicketCreated Boolean @default(false)
  capturedAt      DateTime @default(now())

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Restrict)

  convertedTicketId String? @unique
  convertedTicket Ticket? @relation("TicketSource", fields: [convertedTicketId], references: [id], onDelete: SetNull)

  aiClassifications AiClassification[]

  @@unique([channelId, externalId])
  @@index([channelId])
  @@index([convertedTicketId])
  @@index([capturedAt])
}

model AiClassification {
  id                String @id @default(uuid())
  subjectType       AiSubjectType
  predictedType     TicketType?
  predictedCategory String?
  predictedUrgency  TicketUrgency?
  confidence        Float
  modelName         String
  verified          Boolean @default(false)

  createdAt DateTime @default(now())

  ticketId String?
  ticket   Ticket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  socialId String?
  socialInteraction SocialInteraction? @relation(fields: [socialId], references: [id], onDelete: Cascade)

  predictedOpdId String?
  predictedOpd   Opd? @relation(fields: [predictedOpdId], references: [id], onDelete: SetNull)

  verifiedById String?
  verifiedBy User? @relation("AiVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([socialId])
}

model ActivityLog {
  id          String @id @default(uuid())
  action      String
  entityType  String?
  entityId    String?
  description String? @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}