generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Opd {
  id                  String               @id @default(uuid())
  name                String               @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  categories          Category[]
  tickets             Ticket[]
  ticketVerifications TicketVerification[]
  users               User[]
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  password            String
  name                String
  phone               String
  role                Role                 @default(OPD)
  opdId               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activityLogs        ActivityLog[]
  approvals           Approval[]
  attachments         Attachment[]
  messages            Message[]
  progressChanges     TicketProgress[]
  ticketVerifications TicketVerification[]
  opd                 Opd?                 @relation(fields: [opdId], references: [id])
}

model Citizen {
  id            String           @id @default(uuid())
  displayName   String
  nik           String?
  region        String?
  isBlocked     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  contacts      CitizenContact[]
  tickets       Ticket[]
  conversations Conversation[]
}

model CitizenContact {
  id            String          @id @default(uuid())
  platform      ChannelPlatform
  handle        String
  username      String?
  profilePicUrl String?
  citizenId     String
  createdAt     DateTime        @default(now())
  citizen       Citizen         @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  @@unique([citizenId, platform])
}

model Channel {
  id                 String              @id @default(uuid())
  platform           ChannelPlatform     @unique
  accountHandle      String?
  accountId          String?
  accessToken        String?
  isActive           Boolean             @default(false)
  updatedAt          DateTime            @updatedAt
  socialInteractions SocialInteraction[]
  tickets            Ticket[]
  conversations      Conversation[]
}

model Conversation {
  id            String    @id @default(uuid())
  citizenId     String
  channelId     String
  lastMessageAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  citizen       Citizen   @relation(fields: [citizenId], references: [id], onDelete: Cascade)
  channel       Channel   @relation(fields: [channelId], references: [id])
  messages      Message[]
  tickets       Ticket[]

  @@unique([citizenId, channelId])
  @@index([lastMessageAt])
}

model Category {
  id                  String               @id @default(uuid())
  name                String               @unique
  slug                String               @unique
  defaultOpdId        String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  defaultOpd          Opd?                 @relation(fields: [defaultOpdId], references: [id])
  tickets             Ticket[]
  ticketVerifications TicketVerification[] @relation("OverrideCategory")
}

model Ticket {
  id                String               @id @default(uuid())
  ticketNumber      String               @unique
  title             String?
  description       String
  status            TicketStatus         @default(TO_DO)
  urgency           TicketUrgency?
  type              TicketType?
  citizenId         String
  channelId         String
  conversationId    String?
  categoryId        String?
  assignedOpdId     String?
  location          String?
  startDate         DateTime?
  dueDate           DateTime?
  resolvedAt        DateTime?
  closedAt          DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  attachments       Attachment[]
  messages          Message[]
  sourceInteraction SocialInteraction?   @relation("TicketSource")
  assignedOpd       Opd?                 @relation(fields: [assignedOpdId], references: [id])
  category          Category?            @relation(fields: [categoryId], references: [id])
  channel           Channel              @relation(fields: [channelId], references: [id])
  citizen           Citizen              @relation(fields: [citizenId], references: [id])
  conversation      Conversation?        @relation(fields: [conversationId], references: [id])
  forwardedMessages Message[]            @relation("ForwardedMessages")
  progress          TicketProgress[]
  verifications     TicketVerification[]

  @@index([status])
  @@index([citizenId])
  @@index([assignedOpdId])
  @@index([channelId])
  @@index([categoryId])
  @@index([createdAt])
}

model TicketProgress {
  ticketId    String
  seqNo       Int
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  note        String?
  changedById String?
  changedAt   DateTime      @default(now())
  changedBy   User?         @relation(fields: [changedById], references: [id])
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@id([ticketId, seqNo])
}

model TicketVerification {
  ticketId           String
  seqNo              Int
  verdict            VerificationVerdict
  verifierUserId     String?
  overrideCategoryId String?
  overrideOpdId      String?
  note               String?
  verifiedAt         DateTime            @default(now())
  overrideCategory   Category?           @relation("OverrideCategory", fields: [overrideCategoryId], references: [id])
  overrideOpd        Opd?                @relation(fields: [overrideOpdId], references: [id])
  ticket             Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  verifierUser       User?               @relation(fields: [verifierUserId], references: [id])

  @@id([ticketId, seqNo])
}

model Approval {
  id          String          @id @default(uuid())
  verdict     ApprovalVerdict
  decidedById String?
  decidedAt   DateTime        @default(now())
  reason      String?
  createdAt   DateTime        @default(now())
  decidedBy   User?           @relation(fields: [decidedById], references: [id])
  messages    Message[]
}

model Message {
  id             String           @id @default(uuid())
  content        String
  senderType     SenderType
  direction      MessageDirection
  isInternal     Boolean          @default(false)
  isApproved     Boolean          @default(true)
  isRead         Boolean          @default(false)
  sentAt              DateTime?
  ticketId            String?
  conversationId      String?
  forwardedToTicketId String?
  senderUserId        String?
  approvalId          String?
  externalId          String?          @unique
  replyToMessageId    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  attachments         Attachment[]
  approval            Approval?        @relation(fields: [approvalId], references: [id])
  senderUser          User?            @relation(fields: [senderUserId], references: [id])
  ticket              Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  conversation        Conversation?    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  forwardedToTicket   Ticket?          @relation("ForwardedMessages", fields: [forwardedToTicketId], references: [id])
  replyTo             Message?         @relation("MessageReplies", fields: [replyToMessageId], references: [id])
  replies             Message[]        @relation("MessageReplies")

  @@index([ticketId])
  @@index([conversationId])
  @@index([forwardedToTicketId])
  @@index([replyToMessageId])
  @@index([createdAt])
}

model Attachment {
  id           String   @id @default(uuid())
  url          String
  fileName     String
  mimeType     String
  sizeBytes    Int
  ticketId     String?
  messageId    String?
  uploadedById String?
  uploadedAt   DateTime @default(now())
  message      Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  ticket       Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
}

model SocialInteraction {
  id                String             @id @default(uuid())
  interactionType   InteractionType
  externalId        String
  username          String
  content           String
  permalink         String?
  isTicketCreated   Boolean            @default(false)
  capturedAt        DateTime           @default(now())
  channelId         String
  convertedTicketId String?            @unique
  channel           Channel            @relation(fields: [channelId], references: [id])
  convertedTicket   Ticket?            @relation("TicketSource", fields: [convertedTicketId], references: [id])

  @@unique([channelId, externalId])
  @@index([channelId])
  @@index([convertedTicketId])
  @@index([capturedAt])
}


model ActivityLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String?
  entityId    String?
  description String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum Role {
  ADMIN
  OPD
}

enum TicketStatus {
  TO_DO
  IN_PROGRESS
  ON_HOLD
  DONE
  CANCELLED
}

enum TicketUrgency {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketType {
  COMPLAINT
  FEEDBACK
  QUESTION
}

enum ChannelPlatform {
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum SenderType {
  WARGA
  ADMIN
  OPD
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum InteractionType {
  COMMENT
  MENTION
}

enum ApprovalVerdict {
  APPROVED
  REJECTED
}

enum VerificationVerdict {
  VALID
  INVALID
  NEEDS_REROUTE
}
